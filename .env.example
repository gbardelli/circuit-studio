# Plantilla de variables de entorno. Copia a `.env.local` y rellena solo lo que uses.
# `.env*` está en .gitignore: nunca subas valores reales.
#
# Sin ninguna de estas variables el simulador funciona en modo local (sin cuentas):
# salas WebSocket en :1234 y copia en IndexedDB. Ver README.

# ── Cuentas (Clerk) ── https://dashboard.clerk.com
# La clave pública va al navegador por diseño; la secreta SOLO al servidor.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Base de datos de proyectos y roles (Postgres, p. ej. Neon) ──
DATABASE_URL=

# ── Sincronización en tiempo real (Redis, p. ej. Upstash) ──
REDIS_URL=

# ── Compilación de sketches en la nube (Vercel Sandbox) ──
# En Vercel se autentica sola por OIDC; en local: `vercel env pull`.

# ── Servidor local de salas (opcional) ──
# CS_PORT=1234
# DATA_DIR=./data
# VITE_COLLAB_URL=
